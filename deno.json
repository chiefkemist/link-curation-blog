{
  "nodeModulesDir": "manual",
  "tasks": {
    "dev": "vite",
    "build": "vite build",
    "start": "deno serve -A _fresh/server.js"
  },
  "deploy": {
    "org": "outcastgeek-tech",
    "app": "link-curation-blog",
    "framework": "fresh",
    "install": "deno install",
    "build": "deno task build"
  },
  "imports": {
    "@deno/gfm": "jsr:@deno/gfm@^0.12.0",
    "fresh": "jsr:@fresh/core@^2.2.2",
    "preact": "npm:preact@^10",
    "@preact/signals": "npm:@preact/signals@^2",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1",
    "vite": "npm:vite@^7",
    "@types/babel__core": "npm:@types/babel__core@^7"
  },
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "types": ["vite/client"]
  }
}
