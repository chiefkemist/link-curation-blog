{
  "nodeModulesDir": "manual",
  "tasks": {
    "dev": "vite",
    "build": "vite build",
    "start": "deno run -A _fresh/compiled-entry.js"
  },
  "deploy": {
    "install": "deno install",
    "build": "deno task build",
    "runtime": {
      "type": "dynamic",
      "entrypoint": "deploy-entrypoint.ts"
    }
  },
  "imports": {
    "fresh": "jsr:@fresh/core@^2.2.2",
    "preact": "npm:preact@^10",
    "@preact/signals": "npm:@preact/signals@^2",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1",
    "vite": "npm:vite@^7",
    "@types/babel__core": "npm:@types/babel__core@^7"
  },
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "types": ["vite/client"]
  }
}
